@props(['merchantTypes', 'servicesAll'])

@push('styles')
    <!-- intl-tel-input CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.14.1/build/css/intlTelInput.css">
    <!-- country-select-js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/country-select-js/2.0.1/css/countrySelect.min.css">

    <style>
        .iti {
            width: 100% !important;
        }

        .country-select {
            width: 100% !important;
        }
    </style>
@endpush

@push('scripts')
    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>

    <!-- intl-tel-input JS -->
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.14.1/build/js/intlTelInput.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.14.1/build/js/utils.js"></script>

    <!-- country-select-js JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/country-select-js/2.0.1/js/countrySelect.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const input = document.querySelector("#phone");
            const fullPhoneInput = document.querySelector('#full_phone');
            const countryDropdown = $('#country_select');
            const countryCodeInput = $('#country_code');
            const countryNameInput = $('#country_name');
            const errorMsg = document.querySelector("#error-phone");
            const form = document.querySelector("#contact-form");
            const submitBtn = document.querySelector("#submit-btn");

            // Initialize intl-tel-input
            const iti = window.intlTelInput(input, {
                initialCountry: "jo",
                separateDialCode: true,
                placeholderNumberType: "MOBILE",
            });

            // Initialize country-select-js
            countryDropdown.countrySelect({
                defaultCountry: 'jo',
                preferredCountries: ['jo', 'sa', 'ae'],
                responsiveDropdown: true
            });

            // Sync dropdown -> phone input
            countryDropdown.on('countrychange', function(e, countryData) {
                iti.setCountry(countryData.iso2);
                countryCodeInput.value = countryData.iso2;
                countryNameInput.value = countryData.name;
            });

            // Set initial hidden values
            const initialCountry = iti.getSelectedCountryData();
            countryCodeInput.value = initialCountry.iso2;
            countryNameInput.value = initialCountry.name;
            countryDropdown.countrySelect("selectCountry", initialCountry.iso2);

            const reset = () => errorMsg.textContent = "";

            // Form submit
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                reset();

                const rawNumber = input.value.trim();
                if (!rawNumber) {
                    errorMsg.textContent = "Phone number is required.";
                    return;
                }

                // Get full phone with country code
                const finalPhone = iti.getNumber();
                fullPhoneInput.value = finalPhone;

                // Update country info
                const selectedCountry = iti.getSelectedCountryData();
                countryCodeInput.value = selectedCountry.iso2;
                countryNameInput.value = selectedCountry.name;

                const formData = new FormData(form);
                formData.set('phone', finalPhone);
                formData.set('country_code', selectedCountry.iso2);
                formData.set('country_name', selectedCountry.name);

                submitBtn.disabled = true;

                $.ajax({
                    url: '{{ route('contact-us.supplier-save') }}',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        $('#success-message .alert').text(response.message);
                        $('#success-message').show();
                        form.reset();

                        // Reset phone input and country
                        iti.setCountry("jo");
                        countryDropdown.countrySelect("selectCountry", "jo");
                        const initial = iti.getSelectedCountryData();
                        countryCodeInput.value = initial.iso2;
                        countryNameInput.value = initial.name;
                    },
                    complete: function() {
                        submitBtn.disabled = false;
                    }
                });
            });

            input.addEventListener('input', reset);
        });
    </script>
@endpush

<form id="contact-form" class="contact-form" enctype="multipart/form-data">
    @csrf

    <!-- Hidden inputs -->
    <input type="hidden" name="phone" id="full_phone">
    <input type="hidden" name="country_code" id="country_code">
    <input type="hidden" name="country_name" id="country_name">

    <div class="row">

        <!-- Company Name -->
        <div class="col-md-6 mb-3">
            <input required name="company_name" type="text" class="form-control" placeholder="Company Name">
        </div>

        <!-- Email -->
        <div class="col-md-6 mb-3">
            <input required name="email" type="email" class="form-control" placeholder="E-mail">
        </div>

        <!-- Phone -->
        <div class="col-md-6 mb-3">
            <input type="tel" id="phone" name="phone_manual" required class="form-control" placeholder="Phone">
            <span class="text-danger text-sm" id="error-phone"></span>
        </div>

        <!-- Country Dropdown -->
        <div class="col-md-6 mb-3">
            <input type="text" id="country_select" class="form-control" placeholder="Select Country">
        </div>

        <!-- Website -->
        <div class="col-md-6 mb-3">
            <input required name="website" type="url" class="form-control" placeholder="Website URL">
        </div>

        <!-- Memorandum -->
        <div class="col-md-6 mb-3">
            <input required name="memorandum" type="file" class="form-control" accept=".pdf,.doc,.docx,.jpg,.png">
        </div>

        <!-- License -->
        <div class="col-md-6 mb-3">
            <input required name="license" type="file" class="form-control" accept=".pdf,.doc,.docx,.jpg,.png">
        </div>

        <!-- Submit -->
        <div class="col-md-12 d-grid">
            <button class="btn btn-dark" type="submit" id="submit-btn">Send Message</button>
        </div>

        <!-- Success message -->
        <div class="col-md-12 mt-2" id="success-message" style="display:none;">
            <div class="alert alert-success"></div>
        </div>

    </div>
</form>
